{
  "name": "clintandrewhall.com-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist && rimraf node_modules/.vite && rimraf .vite && rimraf storybook-static && rimraf public/images/portfolio && rimraf public/image_dimensions.json",
    "dev": "react-router dev",
    "build": "yarn clean && react-router build",
    "start": "react-router-serve ./dist/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "generate:github": "tsx ./scripts/github",
    "generate:medium": "tsx ./scripts/medium",
    "lint": "yarn lint:ts && yarn lint:styles",
    "lint:ts": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:styles": "stylelint src/**/*.ts{,x}",
    "storybook": "cross-env BROWSER=\"google chrome\" OPEN_MATCH_HOST_ONLY=true storybook dev -p 6006",
    "build:storybook": "storybook build",
    "upgrade:storybook": "yarn dlx storybook@latest upgrade",
    "chromatic": "chromatic --build-script-name=build:storybook"
  },
