{
  "name": "clintandrewhall.com-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist && rimraf node_modules/.vite && rimraf .vite && rimraf storybook-static && rimraf coverage && rimraf public/images/portfolio && rimraf public/image_dimensions.json",
    "dev": "react-router dev",
    "build": "yarn clean && react-router build",
    "start": "serve dist/client",
    "typecheck": "react-router typegen && tsc",
    "generate:github": "tsx ./scripts/github",
    "generate:medium": "tsx ./scripts/medium",
    "lint": "yarn lint:eslint && yarn lint:format && yarn lint:types",
    "lint:eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix --report-unused-disable-directives && yarn format",
    "lint:format": "yarn format:check",
    "lint:types": "yarn typecheck",
    "format": "prettier --write \"{src,config,scripts,.storybook,types}/**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml,css,html}\" \"*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml,css,html}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"{src,config,scripts,.storybook,types}/**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml,css,html}\" \"*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml,css,html}\" \".github/**/*.{yml,yaml}\"",
    "storybook": "cross-env BROWSER=\"google chrome\" OPEN_MATCH_HOST_ONLY=true storybook dev -p 6006",
    "build:storybook": "storybook build",
    "chromatic": "chromatic --build-script-name=build:storybook",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.2.8",
    "@fontsource/libre-baskerville": "^5.2.10",
    "@linaria/atomic": "^6.3.0",
    "@react-router/node": "^7.17.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "isbot": "^5.1.43",
    "markdown-it": "^14.2.0",
    "node-fetch": "^3.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-intersection-observer": "^10.0.3",
    "react-is": "^19.2.7",
    "react-keyed-flatten-children": "^5.1.2",
    "react-responsive": "^10.0.1",
    "react-router": "^7.17.0",
    "react-scroll-parallax": "^3.5.0",
    "react-scrollspy-navigation": "^2.0.7",
    "ress": "^5.0.2",
    "sharp": "^0.34.5",
    "utopia-core": "^1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@linaria/postcss-linaria": "^6.3.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^16.0.0",
    "@react-router/dev": "^7.17.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/addon-links": "^10.4.5",
    "@storybook/react-vite": "^10.4.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "@wyw-in-js/babel-preset": "^0.8.1",
    "@wyw-in-js/vite": "^0.8.1",
    "chromatic": "^13.3.5",
    "cross-env": "^10.1.0",
    "default-import": "^2.0.8",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-prefer-object-spread": "^1.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.4.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-css-order": "^2.2.0",
    "rimraf": "^6.1.3",
    "rss-parser": "^3.13.0",
    "serve": "^14.2.5",
    "sitemap-static": "^0.4.4",
    "storybook": "^10.4.5",
    "storybook-addon-remix-react-router": "^6.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-imagetools": "^9.0.3",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "packageManager": "yarn@4.10.3",
  "resolutions": {
    "p-map": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
