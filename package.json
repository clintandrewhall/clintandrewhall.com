{
  "name": "clintandrewhall.com-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist && rimraf node_modules/.vite && rimraf .vite && rimraf storybook-static && rimraf public/images/portfolio && rimraf public/image_dimensions.json",
    "dev": "react-router dev",
    "build": "yarn clean && react-router build",
    "start": "react-router-serve ./dist/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "generate:github": "tsx ./scripts/github",
    "generate:medium": "tsx ./scripts/medium",
    "lint": "yarn lint:ts",
    "lint:ts": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "storybook": "cross-env BROWSER=\"google chrome\" OPEN_MATCH_HOST_ONLY=true storybook dev -p 6006",
    "build:storybook": "storybook build",
    "upgrade:storybook": "yarn dlx storybook@latest upgrade",
    "chromatic": "chromatic --build-script-name=build:storybook",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.2.8",
    "@fontsource/libre-baskerville": "^5.2.10",
    "@linaria/atomic": "^6.3.0",
    "@react-router/node": "^7.11.0",
    "@react-router/serve": "^7.11.0",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "isbot": "^5.1.32",
    "markdown-it": "^14.1.0",
    "node-fetch": "^3.3.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^10.0.0",
    "react-is": "^19.2.3",
    "react-keyed-flatten-children": "^5.1.1",
    "react-markdown": "^10.1.0",
    "react-responsive": "^10.0.1",
    "react-router": "^7.11.0",
    "react-scroll-parallax": "^3.5.0",
    "react-scrollspy-navigation": "^2.0.7",
    "ress": "^5.0.2",
    "sharp": "^0.34.5",
    "swiper": "^12.0.3",
    "utopia-core": "^1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@linaria/postcss-linaria": "^6.3.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^16.0.0",
    "@react-router/dev": "^7.11.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/addon-links": "^10.4.5",
    "@storybook/react-vite": "^10.4.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/ui": "^4.0.16",
    "@wyw-in-js/babel-preset": "^0.8.1",
    "@wyw-in-js/vite": "^0.8.1",
    "chromatic": "^13.3.5",
    "cross-env": "^10.1.0",
    "default-import": "^2.0.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-prefer-object-spread": "^1.2.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.4.5",
    "eslint-plugin-testing-library": "^7.15.4",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-css-order": "^2.2.0",
    "rimraf": "^6.1.2",
    "rss-parser": "^3.13.0",
    "serve": "^14.2.5",
    "sitemap-static": "^0.4.4",
    "storybook": "^10.4.5",
    "storybook-addon-remix-react-router": "^6.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-imagetools": "^9.0.2",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "packageManager": "yarn@4.10.3",
  "resolutions": {
    "p-map": "^4.0.0"
  }
}
