{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "@content/*": [
        "./src/content/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@pages/*": [
        "./src/site/pages/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@lib/hooks": [
        "./src/lib/hooks/index"
      ],
      "@state/*": [
        "./src/state/*"
      ],
      "@theme": [
        "./src/theme/index"
      ],
      "@theme/*": [
        "./src/theme/*"
      ]
    }
  },
  "include": [
    "config/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/.stories/**/*.ts",
    "src/**/.stories/**/*.tsx",
    "scripts/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "types/*.d.ts",
    "vite.config.ts",
    "react-router.config.ts",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "types": [
    "vite/client",
    "react-router",
    "react-router-dom",
    "node"
  ],
  "exclude": []
}